{
  "name": "jep-github-action",
  "version": "0.6.0",
  "description": "GitHub Action seed for generating JEP v0.6 event artifacts",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc && ncc build src/index.ts -o dist -m --license licenses.txt",
    "test": "node --test tests/*.test.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@actions/artifact": "^2.1.11",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "typescript": "^5.4.5",
    "@vercel/ncc": "^0.38.3"
  },
  "license": "Apache-2.0"
}
